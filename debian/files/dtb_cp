# kernel post-install hook: /etc/kernel/postinst.d
# populate /boot/dtbs/<version>/rockchip from the kernel package,
# then overlay any out-of-tree dtbs from /boot/dtbs/local

version="$1"

# passing the kernel version is required
[ -z "$version" ] && { echo >&2 "E: dtb_cp: No version number provided"; exit 2; }

src="/usr/lib/linux-image-$version/rockchip"
local_src='/boot/dtbs/local/rockchip'
dst="/boot/dtbs/$version/rockchip"

# a board whose dtbs come entirely from local is valid, so
# fail only when neither source exists
if [ ! -d "$src" ] && [ ! -d "$local_src" ]; then
	echo >&2 "E: dtb_cp: no dtb source found ($src or $local_src)"
	exit 3
fi

rm -rf "/boot/dtbs/$version"
mkdir -p "$dst"

if [ -d "$src" ]; then
	echo "I: dtb_cp: copying $src to $dst"
	cp -a "$src/." "$dst/"
fi

# overlay wins: local dtbs override packaged ones of the same name
if [ -d "$local_src" ]; then
	for f in "$local_src"/*.dtb; do
		[ -e "$f" ] || continue
		b="$(basename "$f")"
		if [ -e "$dst/$b" ]; then
			echo "I: dtb_cp: overriding $b with local copy"
		else
			echo "I: dtb_cp: adding local $b"
		fi
		install -m 644 "$f" "$dst/$b"
	done
fi
