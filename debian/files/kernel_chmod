# kernel post-install hook: /etc/kernel/postinst.d script
# to set permissions after a new kernel is package installed

version="$1"

# passing the kernel version is required
[ -z "$version" ] && { echo >&2 "E: kernel_chmod: No kernel version number provided"; exit 2; }

chmod 600 "/boot/System.map-$version"
chmod 600 "/boot/vmlinuz-$version"

# dtb_cp runs first (hooks run in lexical order) so the tree exists by now
[ -d "/boot/dtbs/$version" ] && find "/boot/dtbs/$version" -name '*.dtb' -exec chmod 644 {} +
